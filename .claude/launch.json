{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dreamtwin-mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@dreamtwin/mobile", "web"],
      "port": 8081
    },
    {
      "name": "dreamtwin-api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@dreamtwin/api", "dev"],
      "port": 3001
    },
    {
      "name": "dreamtwin-web-legacy",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev"],
      "port": 5173
    }
  ]
}
