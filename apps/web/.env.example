# DreamTwins server environment — copy to .env and fill in.
# .env is gitignored; never commit real secrets.

# Frontend (Vite exposes only VITE_-prefixed vars to the browser)
VITE_DREAMTWIN_API_URL=http://127.0.0.1:8787

# API server
PORT=8787
HOST=127.0.0.1

# DeepSeek (server-side only — never expose in frontend)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# MySQL (matches docker-compose.yml defaults)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dreamtwin
MYSQL_PASSWORD=dreamtwin
MYSQL_DATABASE=dreamtwin
MYSQL_ROOT_PASSWORD=rootpw

# Auth
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=30d
